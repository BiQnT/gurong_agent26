# Copy to .env.local. Keep secret values out of source control and VITE_ variables.
# E-UM: https://pohang-eum.kr/data → API 활용 신청
# Raw and URL-encoded service keys are both supported.
EUM_SERVICE_KEY=

# LLM provider (OpenAI-compatible). Defaults to OpenAI when LLM_API_BASE is unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenCode Zen example (https://opencode.ai/docs/zen/): get a key at opencode.ai/auth
# LLM_API_KEY=sk-...
# LLM_API_BASE=https://opencode.ai/zen/v1
# LLM_API_MODEL=big-pickle

# Generic provider variables take precedence over the OPENAI_* ones.

# E-UM 관측 시각에는 시간대 표기가 없지만 한국 시간이다 (실호출로 확인, docs/design/chat-api.md).
# 기본 +09:00 이면 확인 사항 없이 기록할 수 있고, 다른 값은 확인 사항으로 남겨 기록을 막는다.
EUM_TIMEZONE_OFFSET=+09:00
EUM_STALE_AFTER_MINUTES=30

# Public API base URL. / uses the local Vite API bridge (dev and preview).
# A future backend should expose the same /api/observations and /api/chat routes.
VITE_API_BASE_URL=/

# ---- 서버 설정 (운영 서버·VM용. 로컬 개발은 비워 둬도 된다) ----
# 기본값과 동작은 docs/design/backend.md, VM 값은 infra/gcp/backend.env.example

# AI 제공자: claude 면 서버의 claude CLI, 비우면 위의 OpenAI 호환 API
# LLM_PROVIDER=
# claude 실행 파일 경로 (기본 claude)
# CLAUDE_BIN=
# claude 의 빈 작업 폴더
# AGENT_WORKDIR=
# claude 인증 방식: subscription(토큰·서버 로그인) 또는 api_key
# AGENT_AUTH_MODE=
# claude 모델 이름
# AGENT_MODEL=
# claude 추론 강도
# AGENT_EFFORT=
# 메시지 하나당 비용 상한 (USD). 시간 초과 때 기록하는 비용이기도 하다
# AGENT_MAX_BUDGET_USD=
# 메시지 하나당 시간 제한 (ms)
# AGENT_TIMEOUT_MS=
# 동시에 띄우는 claude 최대 수
# AGENT_MAX_CONCURRENCY=
# 최근 24시간 비용 합계 상한 (USD, DATABASE_PATH 가 있을 때만 적용)
# AGENT_DAILY_BUDGET_USD=
# claude 인증 토큰(CLAUDE_CODE_OAUTH_TOKEN 또는 ANTHROPIC_API_KEY)은 이 파일이 아니라 프로세스 환경변수로 준다

# 공유 SQLite 파일 경로. 비우면 .local-data/workspace.json 파일에 저장
# DATABASE_PATH=
# 원격 접속을 허용할 전체 출처 목록 (쉼표 구분, 스킴·호스트·포트 포함)
# PUBLIC_ORIGINS=
# 개발용 터널 호스트 목록 (쉼표 구분, 호스트 이름만 비교)
# PUBLIC_TUNNEL_HOSTS=
# TLS 프록시 뒤에서 세션 쿠키에 Secure 를 붙이려면 1
# COOKIE_SECURE=
# 운영 서버(server/main.ts)가 열 주소와 포트 (기본 127.0.0.1, 3000)
# HOST=
# PORT=

# dev 서버 접속 암호 "아이디:비밀번호" (dev 에만 적용. PUBLIC_ORIGINS 가 있으면 비워 둘 수 없다)
# DEV_BASIC_AUTH=
# dev 서버가 받을 호스트 이름 목록 (쉼표 구분)
# DEV_ALLOWED_HOSTS=
# 프록시 뒤 dev 화면 자동 갱신이 쓸 포트
# DEV_HMR_CLIENT_PORT=

# 기상청 API허브 인증키 (A1~A8, B1~B3). 아직 이 키로 호출하는 기능은 없다
# KMA_AUTH_KEY=
# 공공데이터포털 인증키 (B4~B6). 아직 이 키로 호출하는 기능은 없다
# DATA_GO_KR_KEY=
