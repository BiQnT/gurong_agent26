# /srv/gwamegi/env/secrets.env 의 틀. 실제 값은 VM 에만 두고 커밋하지 않는다.
# 수정: sudo -u gwamegi -e /srv/gwamegi/env/secrets.env  →  sudo systemctl restart gwamegi-dev gwamegi-prod

# E-UM Open API 서비스키 (https://pohang-eum.kr/data → API 자료실 → 활용 신청)
EUM_SERVICE_KEY=

# Claude 인증 방식
#   subscription : 팀 내부 개발·테스트 기간. 로컬에서 `claude setup-token` 으로 받은 토큰을 아래에 넣는다
#   api_key      : 심사·시연 등 외부 사람이 쓰기 전에 전환. claude 를 --bare 로 띄워 ANTHROPIC_API_KEY 만 쓴다
AGENT_AUTH_MODE=subscription
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# 선택. 비우면 claude CLI 기본값
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# AGENT_MAX_BUDGET_USD=0.5
