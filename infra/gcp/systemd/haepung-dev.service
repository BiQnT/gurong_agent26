[Unit]
Description=haepung (dev, 127.0.0.1:3001, Caddy 가 https :440 으로 연다)
After=network-online.target
Wants=network-online.target
# 의존성이 아직 안 깔렸으면(bootstrap 첫 실행 전) 조용히 건너뛴다.
ConditionPathExists=/srv/haepung/dev/node_modules/.bin/vite

[Service]
User=haepung
Group=haepung
UMask=0007
# 공개 주소 뒤에서 도는 프로세스라 권한을 좁힌다. /srv·/var 는 쓰기 가능, /usr·/etc 는 읽기 전용, 팀원 홈은 안 보인다.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
# 메모리가 1.9GB 이고 스왑이 없다. dev 가 폭주해도 prod 가 같이 죽지 않게 cgroup 에서 끊는다 (Restart 로 다시 뜬다).
MemoryHigh=700M
MemoryMax=1000M
# 팀원이 합친 결과를 폰으로 확인하는 공용 폴더를 그대로 vite 로 띄운다 (저장하면 바로 반영).
WorkingDirectory=/srv/haepung/dev
EnvironmentFile=/srv/haepung/env/haepung.env
EnvironmentFile=/srv/haepung/env/backend.env
# bootstrap 이 외부 IP 로 만든다 (PUBLIC_ORIGINS, DEV_ALLOWED_HOSTS, DEV_HMR_CLIENT_PORT).
EnvironmentFile=/etc/haepung/dev.env
Environment=APP_ENV=dev COOKIE_SECURE=1
Environment=DATABASE_PATH=/srv/haepung/db/haepung.db
Environment=AGENT_WORKDIR=/srv/haepung/claude/workdir
Environment=CLAUDE_CONFIG_DIR=/srv/haepung/claude/home
# DEV_BASIC_AUTH 는 backend.env 에서 온다.
ExecStart=/srv/haepung/dev/node_modules/.bin/vite --host 127.0.0.1 --port 3001 --strictPort
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
