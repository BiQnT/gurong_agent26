[Unit]
Description=gwamegi agent (prod, :3000)
After=network-online.target
Wants=network-online.target

[Service]
User=gwamegi
Group=gwamegi
UMask=0007
# 공개 주소에서 도는 프로세스라 권한을 좁힌다. /srv·/var 는 쓰기 가능, /usr·/etc 는 읽기 전용, 팀원 홈은 안 보인다.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
# current 는 deploy.sh 가 바꾸는 링크다. 재시작할 때 새 release 를 가리킨다.
WorkingDirectory=/srv/gwamegi/prod/current/prototype
EnvironmentFile=/srv/gwamegi/env/secrets.env
EnvironmentFile=-/srv/gwamegi/prod/current/release.env
Environment=APP_ENV=prod NODE_ENV=production
# dev 와 같은 DB·claude 작업 폴더를 쓴다 (공유 DB 결정: docs/decisions/0002)
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=DATABASE_PATH=/srv/gwamegi/data/gwamegi.db
Environment=AGENT_WORKDIR=/srv/gwamegi/data/agent-workdir
Environment=CLAUDE_CONFIG_DIR=/srv/gwamegi/data/claude-home
ExecStartPre=/usr/bin/npm run db:migrate
ExecStart=/usr/bin/npm run start -- -p 3000 -H 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
