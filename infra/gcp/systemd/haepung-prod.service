[Unit]
Description=haepung (prod, 127.0.0.1:3000, Caddy 가 https 로 연다)
After=network-online.target
Wants=network-online.target
# current 가 아직 우리 release 가 아니면(첫 배포 전) 조용히 건너뛴다. 부팅 실패로 치지 않는다.
ConditionPathExists=/srv/haepung/current/server/main.ts

[Service]
User=haepung
Group=haepung
UMask=0007
# 공개 주소 뒤에서 도는 프로세스라 권한을 좁힌다. /srv·/var 는 쓰기 가능, /usr·/etc 는 읽기 전용, 팀원 홈은 안 보인다.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
# current 는 deploy.sh 가 바꾸는 링크다. 재시작할 때 새 release 를 가리킨다. 서버는 cwd 기준으로 dist/ 와 src/lib 를 읽는다.
WorkingDirectory=/srv/haepung/current
# 뒤에 나온 파일이 앞의 값을 덮는다. EnvironmentFile 은 Environment= 보다 우선한다.
EnvironmentFile=/srv/haepung/env/haepung.env
EnvironmentFile=/srv/haepung/env/backend.env
EnvironmentFile=-/srv/haepung/current/release.env
# bootstrap 이 외부 IP 로 만든다 (HOST, PORT, PUBLIC_ORIGINS). 앞 파일이 실수로 덮지 못하게 마지막에 둔다.
EnvironmentFile=/etc/haepung/prod.env
Environment=APP_ENV=prod NODE_ENV=production COOKIE_SECURE=1
Environment=DATABASE_PATH=/srv/haepung/db/haepung.db
Environment=AGENT_WORKDIR=/srv/haepung/claude/workdir
Environment=CLAUDE_CONFIG_DIR=/srv/haepung/claude/home
# 접속 암호는 dev 에만 건다. backend.env 를 같이 읽으므로 prod 에서는 값을 지운다.
UnsetEnvironment=DEV_BASIC_AUTH
ExecStart=/usr/bin/env node server/main.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
