[Unit]
Description=haepung SQLite 백업

[Service]
Type=oneshot
User=haepung
Group=haepung
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
Environment=DATABASE_PATH=/srv/haepung/db/haepung.db
Environment=BACKUP_DIR=/srv/haepung/backups
ExecStart=/usr/local/bin/haepung-backup daily
