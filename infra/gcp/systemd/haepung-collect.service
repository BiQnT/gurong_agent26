[Unit]
Description=haepung 30분 수집기 (prod 전용, 한 번 돌고 끝난다)
After=network-online.target
Wants=network-online.target
# 수집기 파일이 아직 없는 release 에서는 조용히 건너뛴다 (타이머가 부팅을 실패시키지 않는다).
ConditionPathExists=/srv/haepung/current/server/collect.ts

[Service]
Type=oneshot
User=haepung
Group=haepung
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
# prod 보다 뒤로 미룬다. 한 번 돌고 끝나는 작업이라 메모리도 작게 끊는다.
Nice=10
MemoryMax=512M
TimeoutStartSec=300
WorkingDirectory=/srv/haepung/current
# prod 와 같은 환경. dev 는 같은 DB 를 쓰므로 수집기를 절대 돌리지 않는다 (두 번 쌓인다).
EnvironmentFile=/srv/haepung/env/haepung.env
EnvironmentFile=/srv/haepung/env/backend.env
EnvironmentFile=-/srv/haepung/current/release.env
EnvironmentFile=/etc/haepung/prod.env
Environment=APP_ENV=prod NODE_ENV=production COOKIE_SECURE=1
Environment=DATABASE_PATH=/srv/haepung/db/haepung.db
Environment=AGENT_WORKDIR=/srv/haepung/claude/workdir
Environment=CLAUDE_CONFIG_DIR=/srv/haepung/claude/home
UnsetEnvironment=DEV_BASIC_AUTH
ExecStart=/usr/bin/env node server/collect.ts
