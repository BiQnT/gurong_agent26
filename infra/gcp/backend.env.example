# /srv/haepung/env/backend.env 의 틀. 실제 값은 VM 에만 두고 커밋하지 않는다.
# bootstrap.sh 가 이 파일을 복사해 만들고 DEV_BASIC_AUTH 를 채운다.
# 수정: sudoedit /srv/haepung/env/backend.env  →  sudo systemctl restart haepung-dev haepung-prod
#
# EUM_SERVICE_KEY 와 OpenAI 키는 팀원이 만든 /srv/haepung/env/haepung.env 에 있다. 거기는 고치지 않는다.
# 이 파일이 haepung.env 뒤에 읽히므로 같은 이름을 쓰면 이 파일이 이긴다.

# AI 제공자: claude 는 서버의 claude CLI, openai 는 OpenAI 호환 HTTP API (haepung.env 의 키)
LLM_PROVIDER=claude
AGENT_MODEL=sonnet
AGENT_EFFORT=medium
# 메모리 1.9GB·스왑 없음이라 동시 2개로 낮췄다. 올리기 전에 free -m 으로 여유를 본다
AGENT_MAX_CONCURRENCY=2

# Claude 인증 방식
#   subscription : 팀 내부 개발·테스트 기간. 로컬에서 `claude setup-token` 으로 받은 토큰을 아래에 넣는다
#   api_key      : 심사·시연 등 외부 사람이 쓰기 전에 전환. ANTHROPIC_API_KEY 만 쓴다
AGENT_AUTH_MODE=subscription
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# 기상청 API허브 인증키 (A1~A8, B1~B3)
KMA_AUTH_KEY=
# 공공데이터포털 인증키 (B4~B6)
DATA_GO_KR_KEY=

# dev 앞의 접속 암호 "아이디:비밀번호". 비우면 bootstrap.sh 가 만들어 넣는다 (prod 에는 적용되지 않는다)
DEV_BASIC_AUTH=

# 선택. 비우면 코드의 기본값
# AGENT_MAX_BUDGET_USD=0.5      메시지 하나당
# AGENT_DAILY_BUDGET_USD=10     최근 24시간 합계 (dev·prod 합산)
# AGENT_TIMEOUT_MS=40000
