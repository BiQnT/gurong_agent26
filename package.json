{
  "name": "guryongpo-gwamegi-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts server/*.test.ts",
    "format": "prettier --write src server index.html vite.config.ts tsconfig.json tsconfig.server.json package.json .prettierrc.json",
    "format:check": "prettier --check src server index.html vite.config.ts tsconfig.json tsconfig.server.json package.json .prettierrc.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^11.2.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.2.2",
    "vite": "^8.3.2"
  }
}
