# 방파제 안내방송 에이전트 — 필요한 키
#
#   cp .env.example .env   (이 폴더에서)
#
# .env 는 gitignore 대상이라 커밋되지 않는다. 값은 절대 여기 적지 말 것.

# --- LLM (방송 문안 생성) ---
# 사람마다 쓰는 모델과 키가 다르다. 본인이 쓸 것만 채운다.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- E-UM 디지털트윈 포항 ---
# 팀 공용이라 레포 루트 .env 에 두는 것을 권장한다. eum_client.py 는
# 이 폴더의 .env 를 먼저 보고, 없으면 루트 .env 로 넘어간다.
# 개인 키를 따로 쓰려면 아래에 채우면 이쪽이 이긴다.
# 발급: https://pohang-eum.kr/data 로그인 → API 자료실 → 활용 신청
# EUM_SERVICE_KEY=
